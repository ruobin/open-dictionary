{
  "name": "open-dictionary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "llm:ping": "tsx scripts/llm-ping.ts",
    "prerender": "tsx scripts/prerender.ts",
    "eval": "tsx scripts/eval-harness.ts",
    "dev:all": "concurrently -n web,api -c blue,magenta \"npm:dev\" \"npm:server\""
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "auth0": "^4.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-oauth2-jwt-bearer": "^1.6.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "mongodb": "^6.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.9"
  }
}

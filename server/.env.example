# Same domain as the frontend
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Identifier of the custom API you registered in Auth0
AUTH0_AUDIENCE=https://ai-dic-api

# M2M app with read:users + update:users on the Management API
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret

# Comma-separated list of allowed browser origins for CORS.
# In production, set this to your real frontend URL(s).
ALLOWED_ORIGINS=http://localhost:5173

# Set to "production" when deploying.
NODE_ENV=development

# If running behind a reverse proxy / load balancer, set to the number of
# proxy hops (typically 1) so rate limiting keys off the real client IP.
TRUST_PROXY=0

PORT=3001

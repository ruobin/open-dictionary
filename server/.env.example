# Same domain as the frontend
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Identifier of the custom API you registered in Auth0
AUTH0_AUDIENCE=https://open-dictionary-api

# M2M app with read:users + update:users on the Management API
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret

# Comma-separated list of allowed browser origins for CORS.
# In production, set this to your real frontend URL(s).
ALLOWED_ORIGINS=http://localhost:5173

# Set to "production" when deploying.
NODE_ENV=development

# If running behind a reverse proxy / load balancer, set to the number of
# proxy hops (typically 1) so rate limiting keys off the real client IP.
TRUST_PROXY=0

PORT=3001

# --- MongoDB (translation cache + favorites) ---
# `docker compose up -d` starts MongoDB on localhost:27017.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=open-dictionary

# --- LLM provider (primary translation tier; see docs/design-translation-cache.md) ---
# Vendor of the LLM provider. Supported: openrouter (default), glm, none.
LLM_VENDOR=openrouter

# === OpenRouter (default) ===
# OpenRouter API key (https://openrouter.ai). Required when LLM_VENDOR=openrouter.
OPENROUTER_API_KEY=
# Model id (default: minimax/minimax-m3 — MiniMax M3)
OPENROUTER_MODEL=minimax/minimax-m3
# Override the OpenRouter API base URL (optional; default https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=
# Optional attribution headers OpenRouter recommends:
# OPENROUTER_REFERER=http://localhost:5173
# OPENROUTER_TITLE=open-dictionary

# === GLM (alternative — set LLM_VENDOR=glm to use) ===
# Z.AI API key (https://z.ai).
# ZAI_API_KEY=
# Model id (default: glm-5.2)
# GLM_MODEL=glm-5.2
# Override the Z.AI API base URL (optional; default https://api.z.ai/api/paas/v4)
# GLM_BASE_URL=

# === Shared ===
# Per-request LLM timeout in ms (optional; default 15000)
# LLM_REQUEST_TIMEOUT_MS=15000
# Verbose LLM request/error logging for debugging (optional; default off)
# LLM_DEBUG=true

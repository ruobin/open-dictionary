# Same domain as the frontend
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Identifier of the custom API you registered in Auth0
AUTH0_AUDIENCE=https://open-dictionary-api

# M2M app with read:users + update:users on the Management API
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret

# Comma-separated list of allowed browser origins for CORS.
# In production, set this to your real frontend URL(s).
ALLOWED_ORIGINS=http://localhost:5173

# Set to "production" when deploying.
NODE_ENV=development

# If running behind a reverse proxy / load balancer, set to the number of
# proxy hops (typically 1) so rate limiting keys off the real client IP.
TRUST_PROXY=0

PORT=3001

# --- MongoDB (translation cache + favorites) ---
# `docker compose up -d` starts MongoDB on localhost:27017.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=open-dictionary

# --- LLM provider (primary translation tier; see docs/design-translation-cache.md) ---
# Vendor of the LLM provider. Supported: deepseek (default), openrouter, glm, none.
LLM_VENDOR=deepseek

# === DeepSeek (default) ===
# DeepSeek API key (https://deepseek.com). Required when LLM_VENDOR=deepseek.
DEEPSEEK_API_KEY=
# Model id (default: deepseek-v4-flash)
DEEPSEEK_MODEL=deepseek-v4-flash
# Override the DeepSeek API base URL (optional; default https://api.deepseek.com)
# DEEPSEEK_BASE_URL=

# === OpenRouter (alternative) ===
# OpenRouter API key (https://openrouter.ai).
# OPENROUTER_API_KEY=
# Model id (default: minimax/minimax-m3 — MiniMax M3)
# OPENROUTER_MODEL=minimax/minimax-m3
# OPENROUTER_BASE_URL=
# Optional attribution headers OpenRouter recommends:
# OPENROUTER_REFERER=http://localhost:5173
# OPENROUTER_TITLE=open-dictionary

# === GLM / Z.AI (alternative) ===
# Z.AI API key (https://z.ai).
# ZAI_API_KEY=
# Model id (default: glm-5.2)
# GLM_MODEL=glm-5.2
# Override the Z.AI API base URL (optional; default https://api.z.ai/api/paas/v4)
# GLM_BASE_URL=

# === Shared ===
# Per-request LLM timeout in ms (optional; default 15000)
# LLM_REQUEST_TIMEOUT_MS=15000
# Verbose LLM request/error logging for debugging (optional; default off)
# LLM_DEBUG=true

# --- Dictionary fallback (Merriam-Webster Collegiate, English-only) ---
# API key from https://www.dictionaryapi.com/
MERRIAM_WEBSTER_API_KEY=
# Override the API base URL (optional; default https://www.dictionaryapi.com/api/v3)
# DICTIONARY_API_BASE=https://www.dictionaryapi.com/api/v3

# --- Rate limits (requests per minute per IP; optional) ---
# TRANSLATE_RATE_LIMIT_RPM=20
# FAVORITES_RATE_LIMIT_RPM=120
# USERDATA_RATE_LIMIT_RPM=60
# SUGGEST_RATE_LIMIT_RPM=60
# REPORT_RATE_LIMIT_RPM=10
# WORD_OF_DAY_RATE_LIMIT_RPM=30
# MORE_EXAMPLES_RATE_LIMIT_RPM=15

# --- SEO prerendering (scripts/prerender.ts; not read by the server itself) ---
# Absolute origin the site is deployed at, no trailing slash. Used to build
# canonical URLs, JSON-LD, and the sitemap. Defaults to http://localhost:5173.
# PUBLIC_BASE_URL=https://dict.ai-dictionary.org

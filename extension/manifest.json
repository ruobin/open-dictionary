{
  "manifest_version": 3,
  "name": "Open Dictionary",
  "version": "0.2.0",
  "description": "Look up any word or phrase instantly \u2014 highlight or right-click.",
  "key": "",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "src/background/serviceWorker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/selectionListener.tsx"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["contextMenus", "storage", "scripting", "activeTab", "identity"],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://dict.ai-dictionary.org/*",
    "https://dev-oz1bs6okox5c8xd0.us.auth0.com/*"
  ],
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
